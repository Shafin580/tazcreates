# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Nothing here is required for the site to build or render — the commission form
# detects missing configuration and shows its Instagram/email fallback instead of
# failing. Fill these in when you are ready to accept form submissions.

# --- Canonical host -------------------------------------------------------------
# Overrides SITE_CONFIG.siteUrl at runtime so preview deploys emit their own host.
NEXT_PUBLIC_SITE_URL=https://tazcreates.site

# --- Indexing -------------------------------------------------------------------
# Unset: only production builds are indexable. Set "false" to force-block a deploy.
# NEXT_PUBLIC_SEO_INDEX=true

# --- Email delivery (Resend) ----------------------------------------------------
# 1. Create a key at https://resend.com/api-keys
# 2. Verify tazcreates.site as a sending domain (DNS records in the Resend dashboard)
# SERVER-ONLY. Must never be prefixed NEXT_PUBLIC_.
RESEND_API_KEY=
# Where commission requests land.
CONTACT_TO_EMAIL=tazmeenzabiyaan8@gmail.com
# Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=commissions@tazcreates.site

# --- Spam protection (Cloudflare Turnstile) -------------------------------------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER-ONLY.
TURNSTILE_SECRET_KEY=
