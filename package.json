{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "og": "tsx scripts/generate-og.tsx",
    "build": "pnpm typecheck && pnpm og && next build",
    "start": "next start",
    "build:cf": "pnpm og && opennextjs-cloudflare build",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "tsc6 --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "prepare": "husky",
    "clean-install": "rm -rf pnpm-lock.yaml node_modules && pnpm install",
    "clean-build": "pnpm run clean-install && pnpm run build",
    "i18n:check": "tsx scripts/i18n/check.ts",
    "i18n:check:ci": "tsx scripts/i18n/check.ts --ci && tsx scripts/i18n/check-placeholders.ts --ci",
    "i18n:check-placeholders": "tsx scripts/i18n/check-placeholders.ts",
    "i18n:sync-keys": "tsx scripts/i18n/sync-keys.ts",
    "i18n:extract": "tsx scripts/i18n/extract.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@react-email/components": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.14.0",
    "next": "^16.2.12",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "resend": "^6.21.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "^6.19.0",
    "wrangler": "^4.125.0"
  }
}
