/**
 * Cloudflare Workers config for the OpenNext adapter.
 *
 * This replaces the old `@cloudflare/next-on-pages` Pages setup: that package is
 * deprecated and does not support Next 16. `opennextjs-cloudflare build` compiles the
 * Next output into `.open-next/worker.js` plus a static `.open-next/assets` directory,
 * both of which are pointed at below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tazcreates",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",

  // nodejs_compat: resend and node-forge both reach for Node built-ins.
  // global_fetch_strictly_public: a fetch to this site's own hostname goes out over the
  // public internet instead of looping back inside the isolate — what Next expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // `wrangler deploy` makes this file the source of truth and overwrites whatever the
  // dashboard says. Configure routes here, not there — a deploy from a config missing
  // these keys detached the custom domain, re-enabled workers.dev, and wiped every var.
  "workers_dev": false,
  "routes": [{ "pattern": "tazcreates.site", "custom_domain": true }],

  // Non-secret runtime values only, read by app/api/commission/route.ts. The list is
  // authoritative: anything omitted here is DELETED from the Worker on deploy.
  //
  // Secrets never go in this file — it is committed. Set RESEND_API_KEY and
  // TURNSTILE_SECRET_KEY with `wrangler secret put <NAME>`. Secrets are stored outside
  // this config and survive deploys untouched, which plaintext vars do not.
  //
  // NEXT_PUBLIC_* are absent on purpose: Next inlines those at build time from
  // .env.local, so a Worker runtime var for them would have no effect.
  "vars": {
    "CONTACT_TO_EMAIL": "tazmeenzabiyaan8@gmail.com",
    "CONTACT_FROM_EMAIL": "commissions@tazcreates.site"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // next/image is used with local files in public/. Without an image binding or a custom
  // loader, optimization fails at runtime. Transformations are metered beyond the free
  // tier — set `images: { unoptimized: true }` in next.config.ts to opt out entirely.
  "images": {
    "binding": "IMAGES"
  }

  // No WORKER_SELF_REFERENCE binding on purpose. OpenNext only needs it to call back
  // into itself for ISR revalidation, and nothing here revalidates — every route is
  // statically generated. Leaving it out also avoids a Worker that binds to itself
  // before it exists on the very first deploy. Add it back (with "service" matching
  // "name" above) in the same change that introduces a revalidating route.
}
